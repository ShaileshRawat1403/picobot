#!/usr/bin/env bash
# Launch Pico's local browser workbench using this repository's profile.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

python_bin="python3"
if [[ -x "$repo_root/.venv/bin/python" ]]; then
  python_bin="$repo_root/.venv/bin/python"
fi

exec "$python_bin" -m picobot web \
  --host 127.0.0.1 \
  --config .picobot/config.json
